# Gembul-Trade — salin ke config/.env lalu isi nilai asli.
# JANGAN PERNAH commit config/.env ke Git!
# Semua variabel dibaca lewat prefix GEMBUL_, dan env selalu menang atas config/config.yaml.

GEMBUL_MODE=paper
GEMBUL_REAL_TRADING_ENABLED=false
GEMBUL_PAPER_EQUITY_USD=1000

# Telegram bot control
GEMBUL_TELEGRAM_TOKEN=
GEMBUL_TELEGRAM_CHAT_ID=0
GEMBUL_ALLOWED_USER_IDS=

# CEX (binance / okx / bybit / bitget) — kosongkan untuk mode paper/dry-run
GEMBUL_CEX_EXCHANGE=binance
GEMBUL_CEX_API_KEY=
GEMBUL_CEX_SECRET=
GEMBUL_CEX_PASSWORD=

# On-chain signing — kosongkan untuk mode paper/shadow
GEMBUL_EVM_PRIVATE_KEY=
GEMBUL_SOLANA_PRIVATE_KEY=

# LLM judge & reflection (OpenRouter / TokenHarbor / OpenAI-compatible)
GEMBUL_LLM_API_KEY=
GEMBUL_LLM_BASE_URL=https://tokenharbor.ai/v1
# Kosongkan untuk memakai daftar default di config/config.yaml
GEMBUL_LLM_MODELS=

# Solana RPC (disarankan pakai Helius gratis / RPC privat agar tidak kena rate-limit)
GEMBUL_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
GEMBUL_HELIUS_API_KEY=

# Freqtrade REST API bridge
GEMBUL_FREQTRADE_PASSWORD=
